Create table Matches (
    Match_ID   INT PRIMARY KEY,
    Team1_ID   INT,
    Team2_ID   INT,
    Match_Date DATE,
    Venue      VARCHAR(100),
    Match_Type VARCHAR(30),
    Winner_ID  INT,
    FOREIGN KEY (Team1_ID) REFERENCES TEAM(Team_ID),
    FOREIGN KEY (Team2_ID) REFERENCES TEAM(Team_ID),
    FOREIGN KEY (Winner_ID) REFERENCES TEAM(Team_ID)
)

